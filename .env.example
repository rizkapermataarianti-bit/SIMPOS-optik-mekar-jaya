#--------------------------------------------------------------------
# Template .env untuk SIMPOS Optik Mekar Jaya
#
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
#
# Jangan commit file .env asli karena berisi kredensial.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
# development = error ditampilkan, debug toolbar aktif
# production  = error disembunyikan, debug toolbar mati
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8082/'
# Sesuaikan dengan port `php spark serve` atau URL Apache yang kamu pakai.
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = dbsimpos
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
# Wajib diisi jika memakai enkripsi data / cookie terenkripsi.
# Buat key dengan: php spark key:generate
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4
