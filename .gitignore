# Environment dan konfigurasi rahasia
.env
.env.*
!.env.example

# Dependensi Composer
/vendor/

# File sementara CodeIgniter
/writable/cache/*
!/writable/cache/.gitkeep
/writable/logs/*
!/writable/logs/.gitkeep
/writable/session/*
!/writable/session/.gitkeep
/writable/debugbar/*
!/writable/debugbar/.gitkeep

# Cache pengujian
.phpunit.cache/
/.phpunit.result.cache

# File sistem operasi
Thumbs.db
.DS_Store